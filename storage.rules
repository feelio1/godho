rules_version = '2';

// 계정 반려동물 사진 저장소 — 펫클 "계정 반려동물 추가/수정" 지시서.
// pet_photos/{uid}/{petId}.jpg는 본인(uid 일치)만 read/write.
// firestore.rules와 같은 원칙(본인 데이터만 접근)이고, 배포는 나중에
// 콘솔/CLI로 한다(이 커밋은 규칙 코드만 커밋).
service firebase.storage {
  match /b/{bucket}/o {
    match /pet_photos/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // "방향 개편" 지시서 H — 일기 사진. 10MB 미만만 허용(책 인쇄용
    // 원본 품질을 유지하므로 펫 사진보다 여유를 둔다).
    match /diary_photos/{uid}/{diaryId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
