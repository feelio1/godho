#include "Generated.xcconfig"

// iOS 비밀값 기본값 (iOS 출시 준비 L-2). 실제 값은 같은 폴더의 Secrets.xcconfig가
// 덮어쓴다 — 그 파일은 .gitignore에 있어 커밋되지 않고, Codemagic이 빌드 직전에
// 환경 변수로 만든다(tool/ios/README.md). 파일이 없어도 빌드·실행은 된다:
// - 광고 앱 ID는 구글 공개 iOS 테스트 앱 ID(테스트 광고)로 대체.
// - 구글 로그인 값이 없으면 구글 버튼만 실패 안내, 앱은 정상 실행.
ADMOB_APP_ID_IOS = ca-app-pub-3940256099942544~1458002511
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = petcli.google-signin.not-configured

#include? "Secrets.xcconfig"
